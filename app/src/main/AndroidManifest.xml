<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Normal permission: read the current connection type / validation state (ConnectivityManager). -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Optional runtime permission. Only requested when the user taps
         "顯示行動網路世代" on the network screen; used solely to read the
         cellular data network type (4G / 5G). Denying it does not affect any other feature. -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-feature android:name="android.hardware.telephony" android:required="false" />

    <!-- Optional development permission. Cannot be requested at runtime; only granted by the user via
         "adb shell pm grant com.galaxy.systemmonitor android.permission.BATTERY_STATS".
         Used solely to read BATTERY_PROPERTY_STATE_OF_HEALTH (battery health %). Without it that
         single value is shown as "permission required" and everything else works unchanged. -->
    <uses-permission
        android:name="android.permission.BATTERY_STATS"
        tools:ignore="ProtectedPermissions" />

    <!-- Optional "usage access" app-op, granted by the user in Settings > Usage access (or via
         "adb shell appops set com.galaxy.systemmonitor GET_USAGE_STATS allow"). Used only by the
         App usage screen to read per-app foreground time and per-app network traffic. -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!-- Install-time permission. Lets the App usage screen turn package names / UIDs from the
         usage and traffic statistics into app names and icons. Without it, most apps would only
         show as a package name or "UID 12345". -->
    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <!-- WorkManager's manifest declares foreground-service support. This app never runs
         foreground work, so the permission and service are removed from the merged manifest. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" tools:node="remove" />

    <application
        android:name=".GalaxyMonitorApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.GalaxyMonitor"
        tools:targetApi="36">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".widget.SmallWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_small_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_small_info" />
        </receiver>

        <receiver
            android:name=".widget.LargeWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_large_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_large_info" />
        </receiver>

        <service
            android:name="androidx.work.impl.foreground.SystemForegroundService"
            tools:node="remove" />
    </application>
</manifest>
